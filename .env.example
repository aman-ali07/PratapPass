# ── PratapPass environment variables ─────────────────────────────
# Copy to `.env.local` (gitignored!) and fill real values.
# Never commit real credentials. `.env.example` stays placeholder-only.

# ── Supabase ──
# Project URL from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server/client anon key (RLS applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SERVICE ROLE key — bypasses RLS. Server-side ONLY; never `NEXT_PUBLIC_*`.
# OPTIONAL: required only when admin/service operations exist (lints via lib/env.ts; local dev
# works without it — see D-013).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── App ──
# Base URL used for QR verification links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Local Supabase CLI (optional, local dev only) ──
# If using `supabase start`, defaults are printed by the CLI;
# they typically point to http://127.0.0.1:54321.

# ── Email delivery (not yet chosen — see KNOWN_ISSUES.md KI-003) ──
# Add credentials here only after the provider decision is recorded
# in docs/DECISIONS.md; MVP uses in-app notifications only.
